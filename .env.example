# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: SQLite for local execution; use PostgreSQL for production)
DATABASE_URL=sqlite:///./secora.db
# DATABASE_URL=postgresql://secora_user:secora_secure_password_2026@localhost:5432/secora_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Inference (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
